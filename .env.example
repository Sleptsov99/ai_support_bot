# Copy to .env and fill in. Never commit .env.
CONSULTANT_BASE_URL=https://cons-suph.top
CONSULTANT_BOT_TOKEN=
WEBHOOK_SECRET=

# Model: claude | deepseek | fake (default: whichever key is set)
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Languages: weak ones through English, the rest handled by the model itself
PIVOT_LANGUAGES=sw,am,zu,ky,af
PIVOT_TARGET=en

KB_PATH=support_bot/data/kb.md
# silence after the question about the time is not a reason for L1 (test review), 0 = off
PAYMENT_SILENCE_SECONDS=0
# 1 only if Consultant renders **bold**
BOT_MARKDOWN=0

# Logs: keep client/bot texts in the turn log (digit runs masked), days to keep, LLM prices (USD per 1M tokens)
LOG_TEXTS=1
LOG_KEEP_DAYS=30
PRICE_INPUT_PER_M=0.28
PRICE_CACHED_PER_M=0.028
PRICE_OUTPUT_PER_M=0.42
